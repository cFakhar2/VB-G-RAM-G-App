rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidCounter(data) {
      return data.keys().hasAll(['count']) && 
             data.keys().size() == 1 &&
             data.count is number;
    }

    // Visitor stats
    match /stats/{statId} {
      allow get: if isValidId(statId);
      
      // Allow anonymous increment for visitor counter
      // In a real app we might want to check the increment value is exactly +1
      // but Firestore rules can't easily check math diffs reliably without Auth or more complexity.
      // For now, let's keep it simple as requested.
      allow create: if isValidId(statId) && isValidCounter(incoming());
      allow update: if isValidId(statId) && 
                      isValidCounter(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['count']);
    }
  }
}
